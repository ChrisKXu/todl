<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Todl.Compiler\Todl.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />

    <!--
      The one deliberate MSBuild dependency in an otherwise MSBuild-free CLI,
      scoped to local project references only (todl-design's
      ideas/tooling/project-file-format.md, Decision 2). ExcludeAssets="runtime"
      keeps these compile-time reference assemblies out of the published
      output, so Microsoft.Build.Locator's assembly-resolve hook (installed
      by MSBuildBootstrap.EnsureRegistered()) is what actually gets loaded at
      run time, redirected to whatever .NET SDK is installed on the machine
      running todl — not the version restored here.
    -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageReference Include="Microsoft.Build" Version="18.9.6" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.9.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Todl.CommandLine.Tests" />
  </ItemGroup>

</Project>
