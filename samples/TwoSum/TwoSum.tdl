import { Console } from System;

void Main() {
    Console.WriteLine(FindPair());
}

// Classic Two Sum via two nested countdown loops; break outer exits both the instant a
// match is found. Parameterless with inlined constants and a foundI == 0 sentinel (rather
// than a `found` flag) to stay within known compiler limits: multi-parameter functions and
// int parameter `.ToString()` calls are currently broken, and a 5th local crashes the emitter.
string FindPair() {
    let i = 9;
    let foundI = 0;
    let foundJ = 0;

    while i > 0 : outer {
        let j = 9;
        while j > i {
            if i + j == 11 {
                foundI = i;
                foundJ = j;
                break outer;
            }
            j = j - 1;
        }
        i = i - 1;
    }

    unless foundI == 0 {
        return foundI.ToString() + " + " + foundJ.ToString();
    }

    return "no pair found";
}
