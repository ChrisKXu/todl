import { Console } from System;
import { Math } from System;

void Main() {
    Console.WriteLine(FindClearTriplet());
}

// Finds the first non-degenerate, obstacle-free triangle among a fixed point set.
// No for-loops in todl: each range loop uses a pre-increment while so
// `continue`/`continue <label>` still advance the index. Distances/areas are compared
// in squared/doubled form to stay in Int32.
string FindClearTriplet() {
    const pointCount = 6;
    const obstacleCount = 2;
    const xs = [0, 120, 10, 12, 50, 20];
    const ys = [0, 0, 10, 13, 40, 60];
    const obstacleXs = [26, 500];
    const obstacleYs = [22, 500];
    const maxBaseDistSquared = 3600;
    const minTwiceArea = 200;

    let i = -1;
    while i < pointCount - 1 {
        i += 1;
        const p1x = xs[i];
        const p1y = ys[i];

        let j = i;
        while j < pointCount - 1 : baseline {
            j += 1;
            const p2x = xs[j];
            const p2y = ys[j];

            // Base too wide: bail out to the next p1.
            if DistanceSquared(p1x, p1y, p2x, p2y) > maxBaseDistSquared {
                break baseline;
            }

            let k = j;
            while k < pointCount - 1 {
                k += 1;
                const p3x = xs[k];
                const p3y = ys[k];
                const area = TwiceArea(p1x, p1y, p2x, p2y, p3x, p3y);

                unless area >= minTwiceArea {
                    continue; // Skip small triangles, stay in this loop.
                }

                let o = -1;
                while o < obstacleCount - 1 {
                    o += 1;

                    // Obstacle inside: skip straight to the next baseline.
                    if IsInside(obstacleXs[o], obstacleYs[o], p1x, p1y, p2x, p2y, p3x, p3y) {
                        continue baseline;
                    }
                }

                // Found it: return unwinds every loop at once.
                const realArea = area / 2;
                return "Clear triplet: (" + p1x + ", " + p1y + ") - ("
                    + p2x + ", " + p2y + ") - ("
                    + p3x + ", " + p3y + "), area " + realArea;
            }
        }
    }

    return "no clear triplet found";
}

int DistanceSquared(int x1, int y1, int x2, int y2) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    return dx * dx + dy * dy;
}

// Twice the triangle's area (shoelace formula); avoids needing a fractional type.
int TwiceArea(int x1, int y1, int x2, int y2, int x3, int y3) {
    const cross = (x2 - x1) * (y3 - y1) - (x3 - x1) * (y2 - y1);
    return Math.Abs(cross);
}

int CrossSign(int px, int py, int ax, int ay, int bx, int by) {
    return (ax - px) * (by - py) - (bx - px) * (ay - py);
}

bool IsInside(int px, int py, int ax, int ay, int bx, int by, int cx, int cy) {
    const d1 = CrossSign(px, py, ax, ay, bx, by);
    const d2 = CrossSign(px, py, bx, by, cx, cy);
    const d3 = CrossSign(px, py, cx, cy, ax, ay);

    const hasNegative = d1 < 0 || d2 < 0 || d3 < 0;
    const hasPositive = d1 > 0 || d2 > 0 || d3 > 0;

    return !(hasNegative && hasPositive);
}
