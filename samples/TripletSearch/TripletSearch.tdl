import { Console } from System;
import { Math } from System;

void Main() {
    Console.WriteLine(FindClearTriplet());
}

// Goal: find the first 3-point configuration (p1, p2, p3) forming a valid, empty
// triangle, bypassing candidate baselines as soon as an obstacle or a size
// constraint rules them out.
//
// todl has no array type and no `for` loop, so:
//   - the point/obstacle sets are hardcoded lookups (PointX/PointY, ObstacleX/ObstacleY)
//     indexed the same way a real array would be;
//   - each bounded range loop below uses the "pre-increment while" idiom: the index
//     starts one below its first value and is incremented as the very first statement
//     in the loop body. That way `continue`/`continue <label>` - which jump straight
//     back to the loop's own condition check, not to a trailing increment - still
//     advance the index correctly.
// Distances and areas are compared in squared/doubled form so everything stays in
// Int32 arithmetic (todl's binary operators only support Int32 today).
string FindClearTriplet() {
    const pointCount = 6;
    const obstacleCount = 2;
    const maxBaseDistSquared = 3600;
    const minTwiceArea = 200;

    let i = -1;
    while i < pointCount - 1 {
        i += 1;
        const p1x = PointX(i);
        const p1y = PointY(i);

        let j = i;
        while j < pointCount - 1 : baseline {
            j += 1;
            const p2x = PointX(j);
            const p2y = PointY(j);

            // 1. Base segment too wide: stop testing p2 candidates for this p1 and
            //    advance straight to the next p1.
            if DistanceSquared(p1x, p1y, p2x, p2y) > maxBaseDistSquared {
                break baseline;
            }

            let k = j;
            while k < pointCount - 1 {
                k += 1;
                const p3x = PointX(k);
                const p3y = PointY(k);
                const area = TwiceArea(p1x, p1y, p2x, p2y, p3x, p3y);

                unless area >= minTwiceArea {
                    continue; // Skip small triangles, stay in this loop.
                }

                let o = -1;
                while o < obstacleCount - 1 {
                    o += 1;

                    // 2. Obstacle validation: if any obstacle sits inside this triangle,
                    //    the whole baseline (p1, p2) is invalid here - skip straight past
                    //    the rest of this loop and the triangle loop to the next baseline.
                    if IsInside(ObstacleX(o), ObstacleY(o), p1x, p1y, p2x, p2y, p3x, p3y) {
                        continue baseline;
                    }
                }

                // 3. Match found! `return` unwinds all three loops immediately.
                const realArea = area / 2;
                return "Clear triplet: (" + p1x.ToString() + ", " + p1y.ToString() + ") - ("
                    + p2x.ToString() + ", " + p2y.ToString() + ") - ("
                    + p3x.ToString() + ", " + p3y.ToString() + "), area " + realArea.ToString();
            }
        }
    }

    return "no clear triplet found";
}

int PointX(int index) {
    if index == 0 { return 0; }
    if index == 1 { return 120; }
    if index == 2 { return 10; }
    if index == 3 { return 12; }
    if index == 4 { return 50; }
    return 20;
}

int PointY(int index) {
    if index == 0 { return 0; }
    if index == 1 { return 0; }
    if index == 2 { return 10; }
    if index == 3 { return 13; }
    if index == 4 { return 40; }
    return 60;
}

int ObstacleX(int index) {
    if index == 0 { return 26; }
    return 500;
}

int ObstacleY(int index) {
    if index == 0 { return 22; }
    return 500;
}

int DistanceSquared(int x1, int y1, int x2, int y2) {
    const dx = x2 - x1;
    const dy = y2 - y1;
    return dx * dx + dy * dy;
}

// Twice the (unsigned) area of triangle (x1,y1)-(x2,y2)-(x3,y3), via the shoelace
// formula. Comparing doubled area avoids needing a fractional type.
int TwiceArea(int x1, int y1, int x2, int y2, int x3, int y3) {
    const cross = (x2 - x1) * (y3 - y1) - (x3 - x1) * (y2 - y1);
    return Math.Abs(cross);
}

int CrossSign(int px, int py, int ax, int ay, int bx, int by) {
    return (ax - px) * (by - py) - (bx - px) * (ay - py);
}

bool IsInside(int px, int py, int ax, int ay, int bx, int by, int cx, int cy) {
    const d1 = CrossSign(px, py, ax, ay, bx, by);
    const d2 = CrossSign(px, py, bx, by, cx, cy);
    const d3 = CrossSign(px, py, cx, cy, ax, ay);

    const hasNegative = d1 < 0 || d2 < 0 || d3 < 0;
    const hasPositive = d1 > 0 || d2 > 0 || d3 > 0;

    return !(hasNegative && hasPositive);
}
